#!/usr/bin/env python3
"""
Simple EXIF Extraction Script
Quick metadata extraction from screenshots

Usage: python extract_exif.py [filename]
       python extract_exif.py [IMG_name].JPG
"""

import sys
from PIL import Image
from PIL.ExifTags import TAGS, GPSTAGS


def extract_and_display_exif(image_path):
    """Extract and display EXIF metadata from an image"""
    
    try:
        # Open image
        img = Image.open(image_path)
        
        # Get EXIF data
        exif_data = img._getexif()
        
        if not exif_data:
            print(f"ERROR: No EXIF data found in {image_path}")
            return
        
        print("=" * 80)
        print(f"EXIF METADATA: {image_path}")
        print("=" * 80)
        
        # Organize by category
        camera_info = {}
        datetime_info = {}
        settings_info = {}
        gps_info = {}
        other_info = {}
        
        for tag_id, value in exif_data.items():
            tag = TAGS.get(tag_id, tag_id)
            
            # Convert bytes to string
            if isinstance(value, bytes):
                try:
                    value = value.decode('utf-8', errors='ignore')
                except:
                    value = str(value)
            
            # Categorize
            if tag in ['Make', 'Model', 'LensMake', 'LensModel', 'Software']:
                camera_info[tag] = value
            elif 'DateTime' in str(tag) or 'Date' in str(tag):
                datetime_info[tag] = value
            elif tag in ['ExposureTime', 'FNumber', 'ISOSpeedRatings', 
                        'FocalLength', 'Flash', 'WhiteBalance']:
                settings_info[tag] = value
            elif tag == 'GPSInfo':
                for gps_tag_id in value:
                    gps_tag = GPSTAGS.get(gps_tag_id, gps_tag_id)
                    gps_info[gps_tag] = value[gps_tag_id]
            else:
                other_info[tag] = value
        
        # Display organized data
        if camera_info:
            print("\nDEVICE INFORMATION:")
            for k, v in camera_info.items():
                print(f"  {k:20s}: {v}")
        
        if datetime_info:
            print("\nDATE/TIME INFORMATION:")
            for k, v in datetime_info.items():
                print(f"  {k:20s}: {v}")
        
        if settings_info:
            print("\nCAMERA SETTINGS:")
            for k, v in settings_info.items():
                print(f"  {k:20s}: {v}")
        
        if gps_info:
            print("\nGPS INFORMATION:")
            for k, v in gps_info.items():
                print(f"  {k:20s}: {v}")
        else:
            print("\nGPS INFORMATION: None (GPS data stripped or not recorded)")
        
        if other_info:
            print("\nOTHER METADATA:")
            for k, v in other_info.items():
                if len(str(v)) < 100:  # Only show reasonably short values
                    print(f"  {k:20s}: {v}")
        
        # File metadata
        import os
        stat = os.stat(image_path)
        print("\nFILE INFORMATION:")
        print(f"  File size: {stat.st_size:,} bytes ({stat.st_size / 1024 / 1024:.2f} MB)")
        print(f"  Image size: {img.size[0]} x {img.size[1]} pixels")
        
        print("\n" + "=" * 80)
        
    except FileNotFoundError:
        print(f"ERROR: File not found: {image_path}")
    except Exception as e:
        print(f"ERROR: Error processing {image_path}: {e}")


def main():
    """Main execution"""
    if len(sys.argv) < 2:
        print("Usage: python extract_exif.py [image_file]")
        print("\nExample:")
        print("  python extract_exif.py [IMG_name].JPG")
        sys.exit(1)
    
    image_path = sys.argv[1]
    extract_and_display_exif(image_path)


if __name__ == "__main__":
    main()
