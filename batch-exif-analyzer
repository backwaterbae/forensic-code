#!/usr/bin/env python3
"""
BatchEXIF py
Process all screenshots in a directory and create summary report

Usage: python batch_exif.py
"""

import os
import json
from PIL import Image
from PIL.ExifTags import TAGS
from datetime import datetime


def process_directory(directory='.', pattern='IMG_', extension='.JPG'):
    """Process all matching images in directory"""
    
    # Get all matching files
    images = sorted([
        f for f in os.listdir(directory)
        if f.startswith(pattern) and f.endswith(extension)
    ])
    
    if not images:
        print(f"ERROR: No images found matching pattern '{pattern}*{extension}'")
        return
    
    print("=" * 80)
    print(f"BATCH PROCESSING: {len(images)} IMAGES")
    print("=" * 80)
    
    results = []
    capture_times = []
    devices = set()
    
    # Process each image
    for idx, img_file in enumerate(images, 1):
        try:
            img = Image.open(os.path.join(directory, img_file))
            exif = img._getexif()
            
            result = {
                'filename': img_file,
                'has_exif': bool(exif)
            }
            
            if exif:
                # Extract key fields
                for tag_id, value in exif.items():
                    tag = TAGS.get(tag_id, tag_id)
                    
                    if isinstance(value, bytes):
                        try:
                            value = value.decode('utf-8', errors='ignore')
                        except:
                            value = str(value)
                    
                    if tag == 'DateTimeOriginal':
                        result['capture_time'] = str(value)
                        capture_times.append(str(value))
                    elif tag == 'Model':
                        result['device'] = str(value)
                        devices.add(str(value))
                
                # Add file info
                stat = os.stat(os.path.join(directory, img_file))
                result['size_bytes'] = stat.st_size
                result['size_mb'] = round(stat.st_size / 1024 / 1024, 2)
            
            results.append(result)
            
            # Progress indicator
            if idx % 10 == 0 or idx == len(images):
                print(f"Progress: {idx}/{len(images)}", end='\r')
        
        except Exception as e:
            print(f"\nERROR: Error processing {img_file}: {e}")
            results.append({
                'filename': img_file,
                'error': str(e)
            })
    
    print(f"\nProcessing complete: {len(results)} images")
    
    # Generate summary
    print("\n" + "=" * 80)
    print("SUMMARY")
    print("=" * 80)
    
    print(f"\nTotal Images: {len(images)}")
    print(f"Successfully Processed: {len([r for r in results if r.get('has_exif')])}")
    print(f"Errors: {len([r for r in results if 'error' in r])}")
    
    if capture_times:
        capture_times.sort()
        print(f"\nTimeline:")
        print(f"   First: {capture_times[0]}")
        print(f"   Last:  {capture_times[-1]}")
        
        # Calculate duration
        try:
            start = datetime.strptime(capture_times[0], "%Y:%m:%d %H:%M:%S")
            end = datetime.strptime(capture_times[-1], "%Y:%m:%d %H:%M:%S")
            duration = end - start
            
            hours = int(duration.total_seconds() // 3600)
            minutes = int((duration.total_seconds() % 3600) // 60)
            
            print(f"   Duration: {hours}h {minutes}m")
        except:
            pass
    
    if devices:
        print(f"\nDevices:")
        for device in sorted(devices):
            count = len([r for r in results if r.get('device') == device])
            print(f"   - {device}: {count} images")
    
    # Save detailed results
    output_file = 'batch_exif_results.json'
    with open(output_file, 'w') as f:
        json.dump({
            'total_images': len(images),
            'processed': len(results),
            'devices': list(devices),
            'timeline': {
                'first': capture_times[0] if capture_times else None,
                'last': capture_times[-1] if capture_times else None
            },
            'images': results
        }, f, indent=2)
    
    print(f"\nDetailed results saved to: {output_file}")
    
    # Create CSV summary
    csv_file = 'batch_exif_summary.csv'
    with open(csv_file, 'w') as f:
        f.write('Filename,Capture Time,Device,Size (MB)\n')
        for r in results:
            f.write(f"{r.get('filename', '')},{r.get('capture_time', '')},{r.get('device', '')},{r.get('size_mb', '')}\n")
    
    print(f"CSV summary saved to: {csv_file}")
    
    # Display sample
    print("\nSample (first 10 images):")
    print("-" * 80)
    for r in results[:10]:
        filename = r.get('filename', 'Unknown')
        capture_time = r.get('capture_time', 'No EXIF')
        device = r.get('device', 'Unknown')
        size_mb = r.get('size_mb', 0)
        
        print(f"{filename:25s} | {capture_time} | {device:15s} | {size_mb:.2f} MB")
    
    print("\n" + "=" * 80)


if __name__ == "__main__":
    process_directory()
