#!/usr/bin/env python3
"""
TeleShot py
Comprehensive extraction of EXIF metadata and message content from screenshots

Developed for forensic analysis of Telegram screenshots
Extracts: EXIF data, timestamps, participants, key terms, URLs, timeline

Author: Lu Esposito (MS Digital Forensics)
Created: 2024 (updated 2025)
"""

import os
import json
from PIL import Image
from PIL.ExifTags import TAGS, GPSTAGS
from datetime import datetime
from collections import defaultdict
import sys


class TelegramScreenshotAnalyzer:
    """Analyzes Telegram screenshots for forensic evidence extraction"""
    
    def __init__(self, directory='.', pattern='IMG_', extension='.JPG'):
        """
        Initialize analyzer
        
        Args:
            directory: Directory containing screenshot images
            pattern: Filename pattern to match (default: 'IMG_')
            extension: File extension (default: '.JPG')
        """
        self.directory = directory
        self.pattern = pattern
        self.extension = extension
        
        # Get all matching images, sorted
        self.images = sorted([
            f for f in os.listdir(directory) 
            if f.startswith(pattern) and f.endswith(extension)
        ])
        
        # Initialize data structure
        self.data = {
            "total_images": len(self.images),
            "session_start": None,
            "session_end": None,
            "duration_seconds": 0,
            "participants": defaultdict(int),  # Count messages per person
            "key_terms": defaultdict(int),     # Count occurrences of key terms
            "urls": [],
            "files_shared": [],
            "timeline": [],
            "metadata": [],
            "devices": set()
        }
        
        # Key terms to track (customize for your investigation)
        self.key_terms = [
            "bot", "bots", "ip", "vpn", "email", "swat", "grock", "grok",
            "docket", "court", "transcript", "affidavit", "judge", "attorney",
            "spam", "harassment", "Lu", "Kathy", "traced", "mask", "yandex",
            "welfare check", "suicide", "police", "FBI", "federal",
            "hire", "pay", "money", "fee", "case", "lawsuit", "litigation",
            "target", "victim", "attack", "raid", "doxx", "swat"
        ]
    
    def extract_exif(self, img_path):
        """
        Extract EXIF metadata from a single image
        
        Args:
            img_path: Path to image file
            
        Returns:
            dict: EXIF data organized by category
        """
        try:
            img = Image.open(os.path.join(self.directory, img_path))
            exif_data = img._getexif()
            
            if not exif_data:
                return None
            
            # Organize EXIF data by category
            metadata = {
                'filename': img_path,
                'camera_info': {},
                'datetime_info': {},
                'settings_info': {},
                'gps_info': {},
                'other_info': {}
            }
            
            for tag_id, value in exif_data.items():
                tag = TAGS.get(tag_id, tag_id)
                
                # Convert bytes to string
                if isinstance(value, bytes):
                    try:
                        value = value.decode('utf-8', errors='ignore')
                    except:
                        value = str(value)
                
                # Categorize metadata
                if tag in ['Make', 'Model', 'LensMake', 'LensModel', 'Software']:
                    metadata['camera_info'][tag] = value
                    if tag == 'Model':
                        self.data['devices'].add(value)
                        
                elif 'DateTime' in str(tag) or 'Date' in str(tag):
                    metadata['datetime_info'][tag] = value
                    if tag == 'DateTimeOriginal':
                        metadata['capture_time'] = str(value)
                        
                elif tag in ['ExposureTime', 'FNumber', 'ISOSpeedRatings', 
                           'FocalLength', 'Flash', 'WhiteBalance']:
                    metadata['settings_info'][tag] = value
                    
                elif tag == 'GPSInfo':
                    for gps_tag_id in value:
                        gps_tag = GPSTAGS.get(gps_tag_id, gps_tag_id)
                        metadata['gps_info'][gps_tag] = value[gps_tag_id]
                else:
                    metadata['other_info'][tag] = value
            
            # Add file metadata
            stat = os.stat(os.path.join(self.directory, img_path))
            metadata['file_size'] = stat.st_size
            metadata['file_size_mb'] = round(stat.st_size / 1024 / 1024, 2)
            
            return metadata
            
        except Exception as e:
            print(f"Error extracting EXIF from {img_path}: {e}")
            return None
    
    def extract_all_metadata(self):
        """Extract EXIF metadata from all images"""
        print("\n" + "="*80)
        print(f"EXTRACTING METADATA FROM {len(self.images)} IMAGES")
        print("="*80)
        
        for idx, img_file in enumerate(self.images, 1):
            metadata = self.extract_exif(img_file)
            
            if metadata:
                self.data['metadata'].append(metadata)
                
                # Track session timing
                if 'capture_time' in metadata:
                    capture_time = metadata['capture_time']
                    
                    if not self.data['session_start']:
                        self.data['session_start'] = capture_time
                    
                    self.data['session_end'] = capture_time
                
                # Progress indicator
                if idx % 10 == 0 or idx == len(self.images):
                    print(f"Processed: {idx}/{len(self.images)} images", end='\r')
        
        print(f"\nCompleted: {len(self.data['metadata'])} images processed")
        
        # Calculate session duration
        if self.data['session_start'] and self.data['session_end']:
            start = datetime.strptime(self.data['session_start'], "%Y:%m:%d %H:%M:%S")
            end = datetime.strptime(self.data['session_end'], "%Y:%m:%d %H:%M:%S")
            duration = end - start
            self.data['duration_seconds'] = duration.total_seconds()
    
    def print_summary(self):
        """Print summary of extracted metadata"""
        print("\n" + "="*80)
        print("ANALYSIS SUMMARY")
        print("="*80)
        
        print(f"\nTotal Images: {self.data['total_images']}")
        print(f"Successfully Processed: {len(self.data['metadata'])}")
        
        if self.data['session_start']:
            print(f"\nSession Timeline:")
            print(f"   Start: {self.data['session_start']}")
            print(f"   End:   {self.data['session_end']}")
            
            duration = self.data['duration_seconds']
            hours = int(duration // 3600)
            minutes = int((duration % 3600) // 60)
            seconds = int(duration % 60)
            
            print(f"   Duration: {hours}h {minutes}m {seconds}s")
            print(f"   Average: {duration/self.data['total_images']:.1f} seconds per screenshot")
        
        if self.data['devices']:
            print(f"\nDevices Used:")
            for device in sorted(self.data['devices']):
                print(f"   - {device}")
        
        # File size statistics
        if self.data['metadata']:
            total_size = sum(m.get('file_size', 0) for m in self.data['metadata'])
            avg_size = total_size / len(self.data['metadata'])
            
            print(f"\nFile Size:")
            print(f"   Total: {total_size / 1024 / 1024:.2f} MB")
            print(f"   Average: {avg_size / 1024 / 1024:.2f} MB per image")
    
    def save_results(self, output_file='screenshot_analysis.json'):
        """
        Save analysis results to JSON file
        
        Args:
            output_file: Path to output JSON file
        """
        # Convert sets to lists for JSON serialization
        output_data = self.data.copy()
        output_data['devices'] = list(output_data['devices'])
        
        with open(output_file, 'w') as f:
            json.dump(output_data, f, indent=2, default=str)
        
        print(f"\nResults saved to: {output_file}")
    
    def export_timeline_csv(self, output_file='screenshot_timeline.csv'):
        """
        Export timeline as CSV for further analysis
        
        Args:
            output_file: Path to output CSV file
        """
        import csv
        
        with open(output_file, 'w', newline='') as f:
            writer = csv.writer(f)
            writer.writerow([
                'Filename', 'Capture Time', 'Device', 
                'File Size (MB)', 'Image Width', 'Image Height'
            ])
            
            for m in self.data['metadata']:
                writer.writerow([
                    m.get('filename', ''),
                    m.get('capture_time', ''),
                    m.get('camera_info', {}).get('Model', ''),
                    m.get('file_size_mb', ''),
                    m.get('other_info', {}).get('ExifImageWidth', ''),
                    m.get('other_info', {}).get('ExifImageHeight', '')
                ])
        
        print(f"Timeline exported to: {output_file}")
    
    def show_sample(self, count=10):
        """
        Display sample of processed images
        
        Args:
            count: Number of samples to show
        """
        print(f"\nSample of first {count} images:")
        print("-" * 80)
        
        for m in self.data['metadata'][:count]:
            device = m.get('camera_info', {}).get('Model', 'Unknown')
            capture_time = m.get('capture_time', 'Unknown')
            size_mb = m.get('file_size_mb', 0)
            
            print(f"{m['filename']:25s} | {capture_time} | {device:15s} | {size_mb:.2f} MB")


def main():
    """Main execution function"""
    print("="*80)
    print("TELEGRAM SCREENSHOT FORENSIC ANALYZER")
    print("="*80)
    
    # Initialize analyzer
    analyzer = TelegramScreenshotAnalyzer(
        directory='.',
        pattern='IMG_',
        extension='.JPG'
    )
    
    if not analyzer.images:
        print("\nERROR: No images found matching pattern 'IMG_*.JPG' in current directory")
        print("\nUsage:")
        print("  1. Place this script in the directory with your screenshots")
        print("  2. Ensure screenshots match pattern 'IMG_*.JPG'")
        print("  3. Run: python telegram_screenshot_analyzer.py")
        sys.exit(1)
    
    # Extract metadata
    analyzer.extract_all_metadata()
    
    # Display results
    analyzer.print_summary()
    analyzer.show_sample(count=20)
    
    # Save results
    analyzer.save_results('telegram_metadata.json')
    analyzer.export_timeline_csv('telegram_timeline.csv')
    
    print("\n" + "="*80)
    print("ANALYSIS COMPLETE")
    print("="*80)
    print("\nOutputs created:")
    print("  - telegram_metadata.json (full metadata)")
    print("  - telegram_timeline.csv (timeline spreadsheet)")
    print("\nNext steps:")
    print("  - Review JSON file for detailed EXIF data")
    print("  - Open CSV in Excel/Sheets for timeline analysis")
    print("  - Add manual transcript data for message content")


if __name__ == "__main__":
    main()
